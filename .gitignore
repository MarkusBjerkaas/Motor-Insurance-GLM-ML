# Publiseres: notebooks, src/, data/ (så andre kan kjøre koden) og README-figurer. Alt annet er lokalt.
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/uv.lock
!/.python-version
!/notebooks/
!/src/
!/data/
!/docs/
/docs/*
!/docs/figures/

# Jupytext-speil (lokale arbeidskopier av notebookene)
notebooks/py_mirrors/
.ipynb_checkpoints/

# Python
__pycache__/
*.py[oc]
*.egg-info
.env
.env.*
