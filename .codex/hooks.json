{
  "description": "Project lifecycle hooks for the notebook workflow.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/sync_analysis_py.py\"",
            "timeout": 30,
            "statusMessage": "Synkroniserer Jupytext-kilder fra notebooker"
          }
        ]
      }
    ]
  }
}
